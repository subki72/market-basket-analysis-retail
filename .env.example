# Market Basket Analysis Engine Configuration
# Copy to .env for local overrides; never commit real .env files.

MBA_MIN_SUPPORT=0.02
MBA_MIN_CONFIDENCE=0.30
MBA_MIN_LIFT=1.0
MBA_MAX_LEN=3
MBA_MAX_ITEMS=500
MBA_DEFAULT_RULES_PATH=MBA_Results_TopRules.csv
MBA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
MBA_LOG_LEVEL=INFO
MBA_RATE_LIMIT_PER_MINUTE=60
MBA_REQUEST_TIMEOUT_SECONDS=10.0
